{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soclabs.org/nanosoc-rm/schemas/pin-state.schema.json",
  "title": "Pin state observation",
  "description": "One pin of one configuration's recursive tree, with its state on each host that holds a copy of the child. Emitted by the pin walker (one JSON object per line) and stored as an observation of kind pin_state. A pin is identified by (parent repo, parent commit, path): rc4 has 44. Owner: pin walker. A3, B2, B3, B7, B9.",
  "type": "object",
  "required": ["schema", "kind", "subject", "observed_at", "sources", "snapshot", "fact"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "pin_state" },
    "subject": {
      "description": "pin_state:<configuration>:<first tree path>",
      "type": "string",
      "pattern": "^pin_state:[a-z0-9][a-z0-9_.-]*:.+$"
    },
    "observed_at": {
      "$ref": "defs.schema.json#/$defs/utc",
      "description": "A3: the OLDEST observed_at inside `fact`, so the envelope never looks fresher than its data."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "defs.schema.json#/$defs/source" }
    },
    "snapshot": {
      "$ref": "defs.schema.json#/$defs/snapshot",
      "description": "M3 / README section 4: one walk of one configuration is one snapshot, scope pin_state:<configuration>. A pin missing from the latest complete snapshot is gone.",
      "properties": { "scope": { "pattern": "^pin_state:" } }
    },
    "fact": { "$ref": "#/$defs/fact" }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["configuration", "parent", "path", "url", "url_kind", "branch_field", "entry_type", "state", "child", "tree_paths", "depth", "split", "effective", "hosts"],
      "additionalProperties": false,
      "properties": {
        "configuration": { "$ref": "defs.schema.json#/$defs/configuration_id" },
        "parent": {
          "description": "B2: the parent commit and the repo it was fetched from: the repo named by the parent's OWN pinned URL, after alias normalisation (for rc4's multicore arch_tech that is the GitLab copy), as the rc4 lock records it. For a depth-1 pin, the configuration's repo.",
          "type": "object",
          "required": ["component", "repo", "commit"],
          "additionalProperties": false,
          "properties": {
            "component": {
              "oneOf": [{ "$ref": "defs.schema.json#/$defs/component_id" }, { "type": "null" }]
            },
            "repo": { "$ref": "defs.schema.json#/$defs/repo" },
            "commit": { "$ref": "defs.schema.json#/$defs/sha" }
          }
        },
        "path": { "type": "string", "minLength": 1 },
        "url": {
          "description": "B9: the URL exactly as .gitmodules at the parent commit writes it.",
          "type": "string",
          "minLength": 1
        },
        "url_kind": {
          "$ref": "defs.schema.json#/$defs/url_kind",
          "description": "B3: `ssh` is the SSH-only badge (no anonymous fetch through this URL); `local` is the local-path state; `relative` is resolved against the parent's pinned repo URL."
        },
        "branch_field": {
          "description": "B3: .gitmodules branch= as written. Recorded for display, never used to compute anything. null when the key is absent; an empty string is never written.",
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "entry_type": {
          "description": "What the parent's tree holds at `path`. Anything but `commit` gives state NO_GITLINK; the walker never drops the entry.",
          "enum": ["commit", "tree", "blob", "absent"]
        },
        "state": {
          "description": "B3 pin-level state, for the two states that do not depend on a host: LOCAL_URL (url_kind local) and NO_GITLINK (entry_type not commit). null for every other pin, whose state lives per host in `hosts`. Both are red for the walk's exit code.",
          "enum": ["LOCAL_URL", "NO_GITLINK", null]
        },
        "child": {
          "type": "object",
          "required": ["component", "catalogued_as", "repo", "commit"],
          "additionalProperties": false,
          "properties": {
            "component": {
              "oneOf": [{ "$ref": "defs.schema.json#/$defs/component_id" }, { "type": "null" }]
            },
            "catalogued_as": {
              "description": "B9: `unknown` = the URL matches no component, copy, alias or external entry, which raises an alert.",
              "enum": ["component", "external", "unknown"]
            },
            "repo": {
              "description": "The repo the URL names, after alias normalisation. null for local/other URLs.",
              "oneOf": [{ "$ref": "defs.schema.json#/$defs/repo" }, { "type": "null" }]
            },
            "commit": {
              "oneOf": [{ "$ref": "defs.schema.json#/$defs/sha" }, { "type": "null" }]
            }
          }
        },
        "tree_paths": {
          "description": "B2: path(s) from the configuration's root checkout, as `git submodule status --recursive` prints them. More than one when the same parent commit appears twice in the tree.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "depth": {
          "description": "B2: 1 for a direct submodule of the configuration. rc4 reaches 5.",
          "type": "integer",
          "minimum": 1
        },
        "split": {
          "description": "B7: the same child component is pinned at more than one commit in this tree.",
          "type": "boolean"
        },
        "effective": {
          "description": "B7: whether the build uses this pin. `unknown` until CI captures the build's file lists.",
          "enum": [true, false, "unknown"]
        },
        "hosts": {
          "description": "B3: one entry per host that has a copy of the child (canonical, copies, aliases resolved). Exactly one entry is `pinned` when any exists. Empty only for LOCAL_URL, NO_GITLINK and uncatalogued (`unknown`) children.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "github": { "$ref": "#/$defs/host_state" },
            "gitlab": { "$ref": "#/$defs/host_state" }
          },
          "not": {
            "required": ["github", "gitlab"],
            "properties": {
              "github": { "properties": { "pinned": { "const": true } } },
              "gitlab": { "properties": { "pinned": { "const": true } } }
            }
          },
          "if": { "minProperties": 1 },
          "then": {
            "anyOf": [
              { "required": ["github"], "properties": { "github": { "properties": { "pinned": { "const": true } } } } },
              { "required": ["gitlab"], "properties": { "gitlab": { "properties": { "pinned": { "const": true } } } } }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "url_kind": { "const": "https" } } },
          "then": { "properties": { "url": { "pattern": "^https://" } } }
        },
        {
          "if": { "properties": { "url_kind": { "const": "ssh" } } },
          "then": { "properties": { "url": { "pattern": "^(ssh://|[A-Za-z0-9._-]+@[^:/]+:)" } } }
        },
        {
          "if": { "properties": { "url_kind": { "const": "local" } } },
          "then": { "properties": { "url": { "pattern": "^(/|file://)" }, "state": { "const": "LOCAL_URL" }, "hosts": { "maxProperties": 0 } } }
        },
        {
          "if": { "properties": { "url_kind": { "const": "relative" } } },
          "then": { "properties": { "url": { "pattern": "^\\.\\.?/" } } }
        },
        {
          "if": { "properties": { "url_kind": { "not": { "const": "local" } }, "entry_type": { "not": { "const": "commit" } } } },
          "then": { "properties": { "state": { "const": "NO_GITLINK" }, "hosts": { "maxProperties": 0 } } }
        },
        {
          "if": { "properties": { "url_kind": { "not": { "const": "local" } }, "entry_type": { "const": "commit" } } },
          "then": { "properties": { "state": { "const": null } } }
        },
        {
          "if": {
            "properties": {
              "entry_type": { "const": "commit" },
              "url_kind": { "enum": ["https", "ssh", "relative"] },
              "child": { "properties": { "catalogued_as": { "enum": ["component", "external"] } } }
            }
          },
          "then": { "properties": { "hosts": { "minProperties": 1 } } }
        }
      ]
    },
    "host_state": {
      "type": "object",
      "required": ["repo", "role", "pinned", "state", "default_branch", "lag", "branches", "tags", "observed_at", "sources"],
      "additionalProperties": false,
      "properties": {
        "repo": { "$ref": "defs.schema.json#/$defs/repo" },
        "role": {
          "description": "Which catalogue repo this is for the child.",
          "enum": ["canonical", "copy", "external", "unknown"]
        },
        "pinned": {
          "description": "True for the host the pinned URL points at: the one a recursive clone uses.",
          "type": "boolean"
        },
        "state": { "$ref": "defs.schema.json#/$defs/pin_state" },
        "default_branch": { "type": ["string", "null"] },
        "lag": {
          "description": "B3: commits on the default branch that the pin lacks. Integer for ON_DEFAULT and TAGGED-on-default, else null.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "branches": {
          "description": "Branches on this host that contain the commit (heads only; never PR/MR refs).",
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "description": "Tags on this host that point at or contain the commit.",
          "type": "array",
          "items": { "type": "string" }
        },
        "observed_at": { "$ref": "defs.schema.json#/$defs/utc" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "defs.schema.json#/$defs/source" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "ON_DEFAULT" } } },
          "then": { "properties": { "lag": { "type": "integer" } } }
        },
        {
          "if": { "properties": { "state": { "const": "BRANCH_ONLY" } } },
          "then": { "properties": { "branches": { "minItems": 1 }, "tags": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "state": { "enum": ["TAGGED", "PROTECTED_BY_TAG"] } } },
          "then": { "properties": { "tags": { "minItems": 1 } } }
        }
      ]
    }
  }
}
