    "yank_proposal": {
      "description": "G6: a proposed yank (a patch to the registry's versioning.yaml); the tag is kept. Refused for a silicon release. Event kind, subject yank_proposal:<target>:<version>.",
      "type": "object",
      "required": [
        "target",
        "commit",
        "ref",
        "worktree",
        "version",
        "tag",
        "entry",
        "refused",
        "tag_kept"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "anyOf": [
            {
              "$ref": "defs.schema.json#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktree": {
          "type": "boolean"
        },
        "version": {
          "$ref": "defs.schema.json#/$defs/semver"
        },
        "tag": {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "entry": {
          "type": "object"
        },
        "refused": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag_kept": {
          "const": true
        },
        "patch_lines": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "refused": {
                "type": "string"
              }
            },
            "required": [
              "refused"
            ]
          },
          "then": {
            "properties": {
              "patch_lines": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "defect_trailers": {
      "description": "F6: Defect:/Fixes: trailers on a component's default branch and the fixed_in entries they propose (a registry patch for a person). Event kind, subject defect_trailers:<target>:<commit>.",
      "type": "object",
      "required": [
        "target",
        "commit",
        "ref",
        "worktree",
        "rows",
        "proposed",
        "already",
        "unresolved"
      ],
      "properties": {
