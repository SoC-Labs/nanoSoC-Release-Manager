{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soclabs.org/nanosoc-rm/schemas/import-ledger.schema.json",
  "title": "Issue-register import ledger (registry/imports.yaml)",
  "description": "F5: every issue in the existing registers, and what became of it: a defect record, a dismissal with a reason, or still pending. Each source document is cited by commit, so it must be committed and pushed first (F3). F5 is done when no item is pending. Owner: registry loader. F3, F5.",
  "type": "object",
  "required": ["schema", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["doc", "items"],
        "additionalProperties": false,
        "properties": {
          "doc": {
            "type": "object",
            "required": ["component", "commit", "path"],
            "additionalProperties": false,
            "properties": {
              "component": { "$ref": "defs.schema.json#/$defs/component_id" },
              "commit": { "$ref": "defs.schema.json#/$defs/sha" },
              "path": { "type": "string", "minLength": 1 }
            }
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["key", "title", "disposition"],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "description": "The item's label in the source document (e.g. `a)`, `1`, `B1`).",
                  "type": "string",
                  "minLength": 1
                },
                "title": { "type": "string", "minLength": 1 },
                "disposition": { "enum": ["record", "dismissed", "pending"] },
                "record": { "type": "string", "pattern": "^SL-DEF-[0-9]{4}$" },
                "reason": { "type": "string", "minLength": 1 }
              },
              "allOf": [
                {
                  "if": { "properties": { "disposition": { "const": "record" } } },
                  "then": { "required": ["record"] }
                },
                {
                  "if": { "properties": { "disposition": { "const": "dismissed" } } },
                  "then": { "required": ["reason"] }
                }
              ]
            }
          }
        }
      }
    }
  }
}
