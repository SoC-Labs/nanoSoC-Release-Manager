{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soclabs.org/nanosoc-rm/schemas/regen.schema.json",
  "title": "Regeneration class measurement (C3, C7; Wave D, built per CR-15)",
  "description": "Shared $defs only (no top-level document): the `fact` of the observation kind regen_class (event, stored): one configuration's generated output regenerated in a sandbox at two commits of one component, and the class of the difference. interfaces.md section 20. Added without a schema bump (README section 2 rule 4): a new optional kind and $defs.",
  "$defs": {
    "verdict": {
      "description": "PASS: both renders ran, the class is measured. FAIL: the generator failed at a commit. INFRA: a render could not run on this host. UNVERIFIED: an override was not reached by the anonymous walk.",
      "enum": ["PASS", "FAIL", "INFRA", "UNVERIFIED"]
    },
    "render": {
      "description": "One render: the configuration's tree with the component at `commit`, regenerated by the registry's regen command.",
      "type": "object",
      "required": ["commit", "status", "verdict", "reason", "files", "binary", "digest", "seconds", "exit_code", "cached", "coverage", "log_tail"],
      "additionalProperties": false,
      "properties": {
        "commit": { "$ref": "defs.schema.json#/$defs/sha" },
        "status": { "enum": ["ok", "failed", "not-run"] },
        "verdict": { "$ref": "#/$defs/verdict" },
        "reason": { "type": ["string", "null"] },
        "files": { "type": "integer", "minimum": 0, "description": "Text files read (normalised) under the output directory." },
        "binary": { "type": "integer", "minimum": 0, "description": "Files left out of the diff: binary, or over the size limit (compared by name only)." },
        "digest": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }], "description": "sha256 over the normalised output; equal digests mean identical output." },
        "seconds": { "type": ["number", "null"] },
        "exit_code": { "type": ["integer", "null"] },
        "cached": { "type": "boolean" },
        "coverage": { "type": "array", "maxItems": 20, "items": { "type": "string" }, "description": "The generator's own lines saying what it skipped (vendor renderers left unset, optional packages absent)." },
        "log_tail": { "type": "array", "maxItems": 10, "items": { "type": "string" } }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "ok" } } }, "then": { "properties": { "verdict": { "const": "PASS" }, "digest": { "type": "string" } } } },
        { "if": { "properties": { "status": { "enum": ["failed", "not-run"] } } }, "then": { "properties": { "verdict": { "not": { "const": "PASS" } }, "reason": { "type": "string" } } } }
      ]
    },
    "regen_class": {
      "description": "C3 3/3 and C7 for one move of one component in one consumer configuration. Event kind, subject regen_class:<component>:<from>:<to>:<configuration>. Only a PASS carries a class. A generator that renders at `from` and fails at `to` is a PASS with class breaking (C5), `files` and `build_affecting` null.",
      "type": "object",
      "required": ["configuration", "component", "tree_paths", "root_commit", "generator", "from", "to", "class", "reasons", "files", "build_affecting", "flists_changed", "coverage", "verdict", "reason", "started_at", "finished_at", "nonce"],
      "additionalProperties": false,
      "properties": {
        "configuration": { "$ref": "defs.schema.json#/$defs/configuration_id" },
        "component": { "$ref": "defs.schema.json#/$defs/component_id" },
        "tree_paths": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Every tree path overridden (a B7 split moves together)." },
        "root_commit": { "oneOf": [{ "$ref": "defs.schema.json#/$defs/sha" }, { "type": "null" }], "description": "The configuration's commit both renders share." },
        "generator": { "const": "sandbox" },
        "from": { "$ref": "#/$defs/render" },
        "to": { "$ref": "#/$defs/render" },
        "class": { "oneOf": [{ "$ref": "defs.schema.json#/$defs/change_class" }, { "type": "null" }] },
        "reasons": { "type": "array", "maxItems": 40, "items": { "type": "string" } },
        "files": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["added", "removed", "changed", "counts"],
              "additionalProperties": false,
              "properties": {
                "added": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
                "removed": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
                "changed": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
                "counts": {
                  "type": "object",
                  "required": ["added", "removed", "changed", "unchanged"],
                  "additionalProperties": false,
                  "properties": {
                    "added": { "type": "integer", "minimum": 0 },
                    "removed": { "type": "integer", "minimum": 0 },
                    "changed": { "type": "integer", "minimum": 0 },
                    "unchanged": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          ]
        },
        "build_affecting": { "type": ["boolean", "null"], "description": "C7: a flist/* variant's file list differs. Null when not measured." },
        "flists_changed": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
        "coverage": { "type": "array", "maxItems": 40, "items": { "type": "string" } },
        "verdict": { "$ref": "#/$defs/verdict" },
        "reason": { "type": ["string", "null"] },
        "started_at": { "$ref": "defs.schema.json#/$defs/utc" },
        "finished_at": { "$ref": "defs.schema.json#/$defs/utc" },
        "nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "PASS" } } },
          "then": { "properties": { "class": { "$ref": "defs.schema.json#/$defs/change_class" } } },
          "else": { "properties": { "class": { "type": "null" }, "reason": { "type": "string" } } }
        }
      ]
    }
  }
}
